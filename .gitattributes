* text=auto
*.py text eol=lf
*.jl text eol=lf
*.mjs text eol=lf
*.md text eol=lf
*.html text eol=lf
*.json text eol=lf
*.cmd text eol=crlf
*.csv -text
*.png binary
*.jpg binary
*.mp4 binary
*.webm binary

# Snapshot hashes refer to exact published bytes, independent of Git EOL settings.
docs/** -text
# Original SSD YAML hashes include their original line endings.
models/**/*.yaml -text
models/*.yaml -text

# The portable Julia environment uses stable lockfile bytes.
simulation/*.toml text eol=lf

# Portable launchers and version locks; do not alter original YAML snapshots.
*.sh text eol=lf
*.toml text eol=lf
*.lock text eol=lf
*.gdml text eol=lf
*.mac text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf

