* text=auto
*.py text eol=lf
*.jl text eol=lf
*.mjs text eol=lf
*.md text eol=lf
*.html text eol=lf
*.json text eol=lf
*.cmd text eol=crlf
*.csv -text
*.png binary
*.jpg binary
*.mp4 binary
*.webm binary

# Snapshot hashes refer to exact published bytes, independent of Git EOL settings.
docs/** -text
# Original SSD YAML hashes include their original line endings.
models/**/*.yaml -text
models/*.yaml -text

# The portable Julia environment uses stable lockfile bytes.
simulation/*.toml text eol=lf

# Portable launchers and version locks; do not alter original YAML snapshots.
*.sh text eol=lf
*.toml text eol=lf
*.lock text eol=lf
*.gdml text eol=lf
*.mac text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf

# Large generated result bundles are reviewed via source/template and manifest hashes.
docs/examples/pipeline.html -diff
docs/examples/data.json -diff

# Generated Li figures/summary are reviewed through source, CSVs and hashes.
docs/lithium/*.html -diff
docs/lithium/*.json -diff

# Generated native-Li example reviewed through source, records and file hashes.
docs/examples/native-li/** -diff

# Byte-exact historical PowerShell receipt intentionally keeps CRLF, not trailing spaces.
docs/examples/cs137-10k/run.json whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Saved Geant4 event records are reviewed through full raw round-trip and SHA-256 checks.
docs/examples/cs137-10k-geometry/*/events-*.json -diff
docs/examples/cs137-10k-geometry/*/scene.json -diff
# Keep the new native scene helper's source hashes stable across Windows/WSL.
tools/geant4_scene/*.cc text eol=lf
tools/geant4_scene/CMakeLists.txt text eol=lf

# Standalone transport launchers must keep their prepared dependency hashes portable.
tools/Start-Transport.ps1 text eol=lf
tools/Monitor-Transport.ps1 text eol=lf
docs/examples/cs137-10k-hits/** -text -diff
