# Publication allowlist: accidental git add . cannot upload the raw workspace.
*
!.gitignore
!.gitattributes
!README.md
!PROGRESS.md
!AGENTS.md
!Publish.cmd
!tools/
!tools/**
!docs/
!docs/**
# Intentional versioned SSD snapshots; original workspace stays ignored.
!models/
!models/*.yaml
!models/catalog.json
!models/README.md
!models/ADLChargeDriftModel/
!models/ADLChargeDriftModel/drift_velocity_config.yaml
# Portable CPU example only; keep generated outputs ignored.
!simulation/
!simulation/Project.toml
!simulation/Manifest.toml
!simulation/run.jl
!simulation/README.md
# Optional GPU and reviewed transport sources only.
!simulation/benchmark.jl
!simulation/test_run.jl
!simulation/gpu/
!simulation/gpu/Project.toml
!simulation/gpu/Manifest.toml
!transport/
!transport/.pixi/
!transport/README.md
!transport/pixi.toml
!transport/pixi.lock
!transport/.pixi/config.toml
!transport/cryostat-source.json
!transport/Run.cmd
!transport/run.sh
!transport/smoke.gdml
!transport/smoke.mac
!transport/check_smoke.py
# Never include local test profiles, raw caches or runtime bytecode.
.local/
**/__pycache__/
**/*.pyc
**/*.jls
**/*.pvsm
**/*.vtr
**/*.bin

# Reviewed M2 event handoff and independent geometry probe.
!simulation/replay.jl
!simulation/test_replay.jl
!transport/handoff.py
!transport/test_handoff.py
!transport/geometry_probe.cc
!transport/CMakeLists.txt

